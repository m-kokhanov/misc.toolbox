# detec the git repo & print branch name

git_branch() {
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return

    git symbolic-ref --short HEAD 2>/dev/null \
        || git rev-parse --short HEAD 2>/dev/null
}

GPART='$(b=$(git_branch); [ -n "$b" ] && printf " \033[01;35mgit:(\033[01;31m%s\033[01;35m)\033[00m" "$b")'
HPART='${debian_chroot:+($debian_chroot)}'
WPART='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]'

PS1="${HPART}${WPART}${GPART}\$ "
