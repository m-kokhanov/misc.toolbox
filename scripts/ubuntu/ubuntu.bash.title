# Show the command currently executing in the terminal title
# trap 'printf "\033]0;%s\007" "$BASH_COMMAND"' DEBUG

trap 'printf "\033]0;%s\007" "$BASH_COMMAND"' DEBUG
export PROMPT_COMMAND='printf "\033]0;%s: %s\007" "${HOSTNAME%%.*}" "$(pwd | sed -e "s;^$HOME;~;") "'


